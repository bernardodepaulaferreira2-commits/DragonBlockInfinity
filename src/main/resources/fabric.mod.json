{
  "schemaVersion": 1,
  "id": "dbi",
  "version": "${version}",

  "name": "Dragon Block Infinity",
  "description": "Dragon Ball RPG mod with races, transformations, ki, stamina, BP, skills, NPCs, HUD and full saga system.",
  "authors": [
    "Bernardo"
  ],
  "license": "MIT",
  "environment": "*",

  "entrypoints": {
    "main": [
      "com.dragonblockinfinity.DragonBlockInfinity"
    ],
    "client": [
      "com.dragonblockinfinity.DragonBlockInfinityClient"
    ]
  },

  "mixins": [
    "dbi.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "1.20.1",
    "java": ">=17"
  }
}
